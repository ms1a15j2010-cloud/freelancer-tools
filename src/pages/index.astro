---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
  <h1>Software picks for freelancers</h1>
  <p class="lede">Plain comparisons of the writing, design, invoicing and project tools that freelancers use to get paid.</p>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <span class="date">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span><br />
        <a class="t" href={`/blog/${p.id}/`}>{p.data.title}</a>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
